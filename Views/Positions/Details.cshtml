@model EmployeeManagement.Web.Models.Position

@{
    ViewData["Title"] = "Position Details";
}

<h2>Position Details</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Position Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@(Model.Description ?? "N/A")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>

    <dt class="col-sm-3">Assigned Employees</dt>
    <dd class="col-sm-9">@ViewBag.EmployeeCount</dd>

    <dt class="col-sm-3">Created At</dt>
    <dd class="col-sm-9">
        @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
    </dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
