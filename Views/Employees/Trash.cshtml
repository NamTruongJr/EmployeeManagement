@model IEnumerable<EmployeeManagement.Web.Models.Employee>

<h2>Deleted Employees</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<a asp-action="Index" class="btn btn-secondary mb-3">
    Back to Employees
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Code</th>
            <th>Full Name</th>
            <th>Department</th>
            <th>Deleted At</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.EmployeeCode</td>
                <td>@employee.FullName</td>
                <td>@employee.Department?.Name</td>
                <td>@employee.DeletedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <form asp-action="Restore"
                          asp-route-id="@employee.Id"
                          method="post">
                        <button type="submit" class="btn btn-sm btn-success">
                            Restore
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
