@model EmployeeManagement.Web.Models.Employee

@{
    ViewData["Title"] = "Employee Profile";
}

<div class="container py-3">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Employee Profile</h2>
            <p class="text-muted mb-0">
                Detailed employee information
            </p>
        </div>

        <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary") fs-6">
            @(Model.IsActive ? "Active" : "Inactive")
        </span>
    </div>

    <div class="row g-4">

        <!-- Personal Information -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-bold">
                    Personal Information
                </div>

                <div class="card-body">
                    <dl class="row mb-0">

                        <dt class="col-sm-5">Employee Code</dt>
                        <dd class="col-sm-7">@Model.EmployeeCode</dd>

                        <dt class="col-sm-5">Full Name</dt>
                        <dd class="col-sm-7">@Model.FullName</dd>

                        <dt class="col-sm-5">Email</dt>
                        <dd class="col-sm-7">
                            @(Model.Email ?? "N/A")
                        </dd>

                        <dt class="col-sm-5">Phone Number</dt>
                        <dd class="col-sm-7">
                            @(Model.PhoneNumber ?? "N/A")
                        </dd>

                        <dt class="col-sm-5">Date of Birth</dt>
                        <dd class="col-sm-7">
                            @(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "N/A")
                        </dd>

                    </dl>
                </div>
            </div>
        </div>

        <!-- Employment Information -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-bold">
                    Employment Information
                </div>

                <div class="card-body">
                    <dl class="row mb-0">

                        <dt class="col-sm-5">Department</dt>
                        <dd class="col-sm-7">
                            @(Model.Department?.Name ?? "Unavailable")
                        </dd>

                        <dt class="col-sm-5">Position</dt>
                        <dd class="col-sm-7">
                            @(Model.Position?.Name ?? "Unassigned")
                        </dd>

                        <dt class="col-sm-5">Hire Date</dt>
                        <dd class="col-sm-7">
                            @Model.HireDate.ToString("dd/MM/yyyy")
                        </dd>

                        <dt class="col-sm-5">Salary</dt>
                        <dd class="col-sm-7">
                            @Model.Salary.ToString("N0")
                        </dd>

                        <dt class="col-sm-5">Created At</dt>
                        <dd class="col-sm-7">
                            @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </dd>

                    </dl>
                </div>
            </div>
        </div>

    </div>

    <!-- Actions -->
    <div class="mt-4">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
            Edit Employee
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Employees
        </a>
    </div>

</div>
