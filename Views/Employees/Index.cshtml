@model IEnumerable<EmployeeManagement.Web.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<h2>Employee Management</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">Add Employee</a>
    <a asp-action="Trash" class="btn btn-outline-danger">Trash</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">

    <div class="col-md-4">
        <input type="text"
               name="searchString"
               value="@ViewBag.SearchString"
               class="form-control"
               placeholder="Search name, code, email..." />
    </div>

    <div class="col-md-3">
        <select name="departmentId" class="form-select">
            <option value="">All Departments</option>
            @foreach (var department in (IEnumerable<SelectListItem>)ViewBag.Departments)
            {
                <option value="@department.Value"
                        selected="@(department.Value == ViewBag.DepartmentId?.ToString() ? "selected" : null)">
                    @department.Text
                </option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <select name="status" class="form-select">
            <option value="">All Status</option>
            <option value="Active"
                    selected="@(ViewBag.Status?.ToString() == "Active" ? "selected" : null)">
                Active
            </option>
            <option value="Inactive"
                    selected="@(ViewBag.Status?.ToString() == "Inactive" ? "selected" : null)">
                Inactive
            </option>
        </select>
    </div>

    <div class="col-md-3">
        <button type="submit" class="btn btn-success">Search</button>
        <a asp-action="Index" class="btn btn-secondary">Reset</a>
    </div>
</form>

<p>Total employees: @ViewBag.TotalItems</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Code</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Hire Date</th>
            <th>Salary</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="8" class="text-center">
                    No employees found.
                </td>
            </tr>
        }
        else
        {
            @foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.EmployeeCode</td>
                    <td>@employee.FullName</td>
                    <td>@employee.Email</td>
                    <td>@(employee.Department?.Name ?? "Unavailable")</td>
                    <td>@employee.HireDate.ToString("dd/MM/yyyy")</td>
                    <td>@employee.Salary.ToString("N0")</td>
                    <td>
                        @if (employee.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>

                    <td>
                        <a asp-action="Details"
                           asp-route-id="@employee.Id"
                           class="btn btn-sm btn-info">
                            Details
                        </a>
                        <a asp-action="Edit"
                           asp-route-id="@employee.Id"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@employee.Id"
                           class="btn btn-sm btn-danger">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@if (ViewBag.TotalPages > 1)
{
    <nav>
        <ul class="pagination">

            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-searchString="@ViewBag.SearchString"
                       asp-route-departmentId="@ViewBag.DepartmentId"
                       asp-route-status="@ViewBag.Status">
                        @i
                    </a>
                </li>
            }

        </ul>
    </nav>
}
