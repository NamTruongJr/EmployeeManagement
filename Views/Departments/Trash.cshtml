@model IEnumerable<EmployeeManagement.Web.Models.Department>

@{
    ViewData["Title"] = "Deleted Departments";
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Deleted Departments</h2>
        <p class="text-muted">View and restore deleted departments</p>
    </div>

    <a asp-action="Index" class="btn btn-secondary">
        Back to Departments
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Department Name</th>
                    <th>Description</th>
                    <th>Deleted At</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            Trash is empty.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var department in Model)
                    {
                        <tr>
                            <td>@department.Id</td>
                            <td>@department.Name</td>
                            <td>@department.Description</td>
                            <td>
                                @(department.DeletedAt?.ToLocalTime()
                                    .ToString("dd/MM/yyyy HH:mm"))
                            </td>
                            <td>
                                <form asp-action="Restore"
                                      asp-route-id="@department.Id"
                                      method="post">
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-success">
                                        Restore
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>