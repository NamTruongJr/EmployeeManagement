@model List<EmployeeManagement.Web.Models.ViewModels.UserListItemViewModel>

@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>User Management</h2>
            <p class="text-muted">
                Manage system accounts and user permissions.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create Account
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form asp-action="Index" method="get"
                  class="row g-2">

                <div class="col-md-5">
                    <input type="text"
                           name="searchString"
                           value="@ViewBag.SearchString"
                           class="form-control"
                           placeholder="Search by email..." />
                </div>

                <div class="col-auto">
                    <button type="submit"
                            class="btn btn-outline-primary">
                        Search
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Reset
                    </a>
                </div>

            </form>

        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Email</th>
                            <th>Username</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th style="min-width: 220px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-4">
                                    No accounts found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            var index = 1;

                            foreach (var user in Model)
                            {
                                <tr>
                                    <td>@index</td>

                                    <td>@user.Email</td>

                                    <td>@user.UserName</td>

                                    <td>
                                        @if (user.Role.Contains("Admin"))
                                        {
                                            <span class="badge bg-danger">
                                                @user.Role
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">
                                                @user.Role
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (user.IsLocked)
                                        {
                                            <span class="badge bg-danger">
                                                Locked
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">

                                            <a asp-action="EditRole"
                                               asp-route-id="@user.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit Role
                                            </a>

                                            @if (user.IsLocked)
                                            {
                                                <form asp-action="Unlock"
                                                      asp-route-id="@user.Id"
                                                      method="post">

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success">
                                                        Unlock
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Lock"
                                                      asp-route-id="@user.Id"
                                                      method="post"
                                                      onsubmit="return confirm('Are you sure you want to lock this account?');">

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger">
                                                        Lock
                                                    </button>
                                                </form>
                                            }

                                        </div>
                                    </td>
                                </tr>

                                index++;
                            }
                        }

                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>